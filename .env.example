# App
APP_NAME=chat-platform
APP_ENV=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chat_platform
POSTGRES_USER=chat_user
POSTGRES_PASSWORD=chat_password

# PostgreSQL test database
# Used by opt-in backend tests: mix test --include postgres_integration
POSTGRES_TEST_HOST=localhost
POSTGRES_TEST_PORT=5432
POSTGRES_TEST_DATABASE=chat_platform_test
POSTGRES_TEST_USER=chat_user
POSTGRES_TEST_PASSWORD=chat_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# API rate limiting.
# ENABLED gates the PRE-SESSION auth limiters only (OTP request 3/60s, OTP verify 20/300s) --
# the in-controller limits (contacts sync, broadcast send, reports, username check) and the
# /v1 per-app limit are always on. Production sets this true; leaving it false disables the
# anti-SMS-fraud and OTP brute-force bounds. See docs/09-devops/RATE_LIMIT_POLICY.md.
API_RATE_LIMITING_ENABLED=true
RATE_LIMITER_REDIS_URL=redis://localhost:6379/0
RATE_LIMITER_FAIL_OPEN=true
RATE_LIMITER_REDIS_TIMEOUT_MS=1000

# ScyllaDB
MESSAGE_STORE_ADAPTER=query_plan
SCYLLA_CONTACT_POINTS=localhost:9042
SCYLLA_HOST=localhost
SCYLLA_PORT=9042
SCYLLA_KEYSPACE=chat_messages
SCYLLA_TIMEOUT_MS=5000

# Kafka
KAFKA_BROKERS=localhost:9094

# MinIO
MEDIA_STORAGE_ADAPTER=query_plan
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE=http://localhost:9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chat-media
MINIO_REGION=us-east-1
MINIO_URL_EXPIRES_SECONDS=900
MINIO_PATH_STYLE=true

# Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI=http://localhost:8025

# Auth
JWT_ACCESS_SECRET=change_me_local_access_secret
JWT_REFRESH_SECRET=change_me_local_refresh_secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# OTP delivery (login codes)
# --------------------------------------------------------------------------------------------------
# SMS provider selector. "console" (default) = LOCAL/DEV: no real SMS, no credits/DLT needed; the code
# is logged (dev) and can be echoed to the browser via OTP_DELIVERY_MODE=echo. "smsgatewayhub" = PROD:
# real DLT-compliant texts (requires the SMSGatewayHub secrets + approved DLT sender/template below).
SMS_PROVIDER=console
# Local convenience to obtain the code WITHOUT SMS: echo → returned in the OTP-request response
# (debug_code, visible in the browser), log → written to logs, none → nothing (prod-safe). LOCAL/STAGING ONLY.
OTP_DELIVERY_MODE=echo

# SMSGatewayHub credentials + DLT registration (only needed when SMS_PROVIDER=smsgatewayhub).
# You must create these yourself: SMSGatewayHub account + API key + credits, and TRAI/DLT registration
# of the sender ID (header) and the OTP template. Real SMS will NOT deliver until DLT is approved.
SMS_GATEWAY_HUB_API_KEY=            # your SMSGatewayHub API key (secret)
SMS_GATEWAY_HUB_SENDER_ID=ISOOBC    # DLT-approved 6-char sender ID / header
SMS_GATEWAY_HUB_ROUTE=              # provider route id (per your SMSGatewayHub plan)
SMS_ENTITY_ID=                      # your DLT Principal Entity ID
SMS_TEMPLATE_LOGIN_ID=             # DLT-approved LOGIN template id (the "DLT template id")
# OTP message body — {code} is replaced with the OTP. MUST match the DLT-approved wording verbatim.
# Leave blank to use the built-in default: "Dear user, your login OTP is {code} 1500BC".
SMS_OTP_TEMPLATE=
# Optional overrides (sensible defaults in runtime.exs): SMS_GATEWAY_HUB_BASE_URL, SMS_GATEWAY_HUB_SEND_PATH,
# SMS_GATEWAY_HUB_CHANNEL, SMS_GATEWAY_HUB_DCS, SMS_GATEWAY_HUB_FLASHSMS, SMS_COUNTRY_PREFIX (default 91).
