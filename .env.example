# App
APP_NAME=chat-platform
APP_ENV=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chat_platform
POSTGRES_USER=chat_user
POSTGRES_PASSWORD=chat_password

# PostgreSQL test database
# Used by opt-in backend tests: mix test --include postgres_integration
POSTGRES_TEST_HOST=localhost
POSTGRES_TEST_PORT=5432
POSTGRES_TEST_DATABASE=chat_platform_test
POSTGRES_TEST_USER=chat_user
POSTGRES_TEST_PASSWORD=chat_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# API rate limiting
API_RATE_LIMITING_ENABLED=false
RATE_LIMITER_REDIS_URL=redis://localhost:6379/0
RATE_LIMITER_FAIL_OPEN=true
RATE_LIMITER_REDIS_TIMEOUT_MS=1000

# ScyllaDB
MESSAGE_STORE_ADAPTER=query_plan
SCYLLA_CONTACT_POINTS=localhost:9042
SCYLLA_HOST=localhost
SCYLLA_PORT=9042
SCYLLA_KEYSPACE=chat_messages
SCYLLA_TIMEOUT_MS=5000

# Kafka
KAFKA_BROKERS=localhost:9094

# MinIO
MEDIA_STORAGE_ADAPTER=query_plan
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE=http://localhost:9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chat-media
MINIO_REGION=us-east-1
MINIO_URL_EXPIRES_SECONDS=900
MINIO_PATH_STYLE=true

# Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI=http://localhost:8025

# Auth
JWT_ACCESS_SECRET=change_me_local_access_secret
JWT_REFRESH_SECRET=change_me_local_refresh_secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
