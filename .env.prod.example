# Copy to `.env` (compose auto-loads it) and fill in real values for docker-compose.prod.yml.
#   cp .env.prod.example .env
#
# Generate each secret with:  openssl rand -hex 32   (or: mix phx.gen.secret for SECRET_KEY_BASE)
# These are read at boot by config/runtime.exs; the prod guard refuses to start without them and
# rejects known insecure placeholders. NEVER commit the filled-in .env.

# Shared internal-API token — MUST be identical across the gateway and every service container
# (TokenPlug rejects any mismatch with HTTP 401).
INTERNAL_API_TOKEN=

# Phoenix / auth secrets (each a long random value).
SECRET_KEY_BASE=
TOKEN_SECRET=
OTP_SECRET=
