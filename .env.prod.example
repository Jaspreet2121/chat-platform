# Production .env template for docker-compose.prod.yml. Copy to `.env` (compose auto-loads it) and fill in
# real values, then follow docs/09-devops/PROD_DEPLOY_RUNBOOK.md.
#   cp .env.prod.example .env
#
# Read at boot by config/runtime.exs; the prod guard refuses to start without the secrets and rejects
# known insecure placeholders. NEVER commit the filled-in .env (it is gitignored).
#
# =========================== SECRETS — generate FRESH, keep private ===========================
# Generate each with:  openssl rand -hex 32      (SECRET_KEY_BASE: openssl rand -hex 64)

# Shared internal-API token — MUST be identical across the gateway and every service (TokenPlug 401s on
# mismatch). One value, used everywhere.
INTERNAL_API_TOKEN=

# Phoenix / auth signing secrets (long random values).
SECRET_KEY_BASE=
TOKEN_SECRET=
OTP_SECRET=

# Postgres password — used by BOTH the postgres container and every service's DATABASE_URL.
POSTGRES_PASSWORD=

# MinIO (object storage) root credentials — used by the minio container, minio-init, AND the media
# service (they must match). Not "minioadmin".
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# =========================== HOST / URL CONFIG (not secret) ===========================
# Public host used for URL generation. First deploy = the EC2 public IP; later = your domain.
PHX_HOST=CHANGE_ME_EC2_IP_OR_DOMAIN

# Websocket origin allow-list (realtime socket check_origin). Empty disables the check (OK for an IP
# smoke test); set to your web origin once behind a proxy, e.g. https://app.example.com
WEB_ORIGIN=

# Allowed browser CORS origin(s) for the API, comma-separated. The web frontend's origin.
# First HTTP deploy: http://<EC2_IP>  (or wherever the web app is served). Later: https://app.example.com
CORS_ORIGIN=http://CHANGE_ME_EC2_IP

# Browser-reachable MinIO endpoint that presigned media URLs are signed against — the SigV4 host must be
# what the browser actually hits. With MinIO loopback-bound, this is the Caddy-fronted URL (phase 2):
#   https://media.example.com   (recommended)
# For a pre-Caddy IP smoke test only: temporarily publish MinIO on 9000 and set http://<EC2_IP>:9000
MINIO_PUBLIC_ENDPOINT=http://CHANGE_ME_EC2_IP:9000

# =========================== SMS (OTP delivery) ===========================
# console = no real SMS (dev). smsgatewayhub = real DLT SMS (prod). Set to smsgatewayhub for real users.
SMS_PROVIDER=smsgatewayhub
# none (prod-safe: OTP only via SMS) | echo (returns the code in the API response — LOCAL/STAGING ONLY).
OTP_DELIVERY_MODE=none
# SMSGatewayHub + DLT credentials (from your account / DLT registration).
SMS_GATEWAY_HUB_API_KEY=
SMS_GATEWAY_HUB_SENDER_ID=ISOOBC
SMS_GATEWAY_HUB_ROUTE=
SMS_ENTITY_ID=
SMS_TEMPLATE_LOGIN_ID=
# OTP message body ({code} → the OTP). Leave blank for the built-in DLT-approved default.
SMS_OTP_TEMPLATE=
# Send the bare 10-digit number (drop 91) when true. Default false (91-prefixed).
SMS_STRIP_COUNTRY_CODE=false

# =========================== OPTIONAL ===========================
# Session lifetimes (seconds): default 3h / remember-me 7d. Uncomment to override.
# AUTH_SESSION_TTL_SECONDS=10800
# AUTH_SESSION_REMEMBER_TTL_SECONDS=604800

# Kafka fanout (push notifications). PHASE 1 = OFF (leaner; core chat/realtime/login/media/admin all work
# without it — only push-notification fanout is absent). Don't start the kafka/kafka-init/notification
# services (the runbook's `up -d` list omits them). To ENABLE later: set both to true, start those
# services (`docker compose ... up -d kafka kafka-init notification`) — it works (KAFKA_BROKERS is honored
# at runtime).
KAFKA_PUBLISH_ENABLED=false
CONVERSATION_PUBLISH_ENABLED=false

# Max media upload size in bytes (default 100 MB).
# MEDIA_MAX_SIZE_BYTES=104857600
