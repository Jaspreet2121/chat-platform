# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.prod.example

# Secrets that may be dropped in-tree during local setup. The FCM service-account JSON contains a
# private key — if it is ever mounted from the repo instead of a secret store, it must not be
# committed. (Firebase's default download name is included; so is anything *-service-account.json.)
*service-account*.json
fcm-*.json

# Node / Nx
node_modules/
dist/
build/
.next/
.expo/
.nx/
coverage/

# Elixir / Phoenix
_build/
deps/
*.ez
erl_crash.dump

# Logs
*.log

# Docker volumes
docker-data/
tmp/

# IDE
.vscode/
.idea/
# Editor / shell backups. `docker-compose.prod.yml.save` is what `nano` leaves behind after an
# on-server edit — exactly how the FCM wiring drifted out of the repo in the first place.
*.save
*.save.*

# Timestamped Caddyfile backups made before edits on the prod host.
infra/caddy/Caddyfile.bak.*
