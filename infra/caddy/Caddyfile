# PHASE 2 — domains with automatic HTTPS (Let's Encrypt). Requires DNS A-records for each host below
# pointing at the EC2 public IP, and inbound 80+443 open in the security group (80 is needed for the
# ACME challenge). Caddy obtains + renews certs automatically (persisted in the caddy_data volume).
#
# Caddy runs as the `caddy` service in docker-compose.prod.yml. To activate this file, change that
# service's mount from ./infra/caddy/Caddyfile.http to ./infra/caddy/Caddyfile, set in .env:
#   PHX_HOST=api.growblic.com
#   WEB_ORIGIN=https://web.growblic.com,https://admin.growblic.com
#   CORS_ORIGIN=https://web.growblic.com,https://admin.growblic.com
#   MINIO_PUBLIC_ENDPOINT=https://media.growblic.com
# then `docker compose -f docker-compose.prod.yml up -d`.

# --- API + realtime websocket ---
api.growblic.com {
	header {
		# HSTS: the API is HTTPS-only in production and every client already speaks it.
		Strict-Transport-Security "max-age=31536000"
		# JSON is JSON. Stops a browser sniffing an error body into something executable.
		X-Content-Type-Options "nosniff"
	}

	reverse_proxy gateway:4000
}

# --- Media (MinIO S3 API) — presigned PUT/GET; Host is preserved so SigV4 matches ---
#
# THE UPLOADED CONTENT-TYPE IS ATTACKER-CHOSEN. The presign signs `SignedHeaders=host` ONLY
# (MediaService.Storage), so MinIO never validates the Content-Type a client sends on the PUT — the
# server-side allowlist in MediaService.Media governs the DATABASE ROW, not the stored object. A user
# can declare image/png at create, PUT bytes as text/html, and MinIO will serve them back as text/html.
#
# These three headers make that inert without touching the signing path:
#   * Content-Disposition attachment — a top-level navigation DOWNLOADS instead of rendering, so
#     stored HTML/SVG cannot execute on this origin. <img>/<video> subresource loading is UNAFFECTED
#     (the header only governs how a navigation is handled), so chat media renders exactly as before.
#   * nosniff — stops a browser inferring a richer type than the one served.
#   * CSP sandbox — a fully-restricted origin for anything that does get rendered: no scripts, no
#     forms, no same-origin privileges.
#
# Header manipulation does not disturb SigV4: the signature covers the request's host and query, and
# these are RESPONSE headers.
media.growblic.com {
	header {
		Content-Disposition "attachment"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "sandbox"
	}

	reverse_proxy minio:9000
}

# --- Web frontend (Next.js `web` service) — one app serves both: chat at /, admin at /admin ---
#
# ANDROID APP-LINK VERIFICATION (/.well-known/assetlinks.json). Read this before changing it — this
# exact block has taken production down TWICE:
#   1. A SECOND `web.growblic.com { }` block → "ambiguous site definition" → Caddy restart-looped.
#      api/web/media ALL proxy through this Caddy, so the whole site went down. There must be exactly
#      ONE block per site name; the handler below lives INSIDE the existing one.
#   2. `web.growblic.com.` (trailing dot) as an additional site name → "subject does not qualify for
#      certificate" → same outcome.
# And it is a `file_server`, NOT `respond`, for a third reason: `respond` with a backtick-quoted JSON
# body returned HTTP 200 with content-length: 0 — the body never survived Caddyfile quoting, so the
# endpoint looked healthy and served nothing. DO NOT "simplify" this back into a respond.
#
# THE FINGERPRINT IN assetlinks.json BELONGS TO THE RELEASE KEYSTORE. If the app is ever re-signed
# (new keystore, Play App Signing enrolment, or a key rotation), that SHA-256 changes and this file
# MUST be updated in the same change — otherwise Android silently stops verifying and every deep link
# reverts to the chooser dialog, with no server-side error to notice.
web.growblic.com {
	# Site-level response headers. Deliberately INSIDE the existing block — a second `web.growblic.com`
	# block is an "ambiguous site definition" that restart-loops Caddy and takes api/web/media down with
	# it (see the warning below; it has happened twice).
	#
	# NO full Content-Security-Policy here this pass: Next.js inlines bootstrap scripts and a CSP written
	# without measuring which hashes/nonces it needs would break the app on deploy. That is its own slice.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# First matching `handle` wins; the second is the catch-all. Explicit handles (rather than a bare
	# reverse_proxy alongside a matcher) keep the precedence obvious to the next reader.
	handle /.well-known/assetlinks.json {
		root * /srv
		header Content-Type application/json
		file_server
	}

	handle {
		reverse_proxy web:3000
	}
}

admin.growblic.com {
	# Same three as the web host — one app serves both, so the posture must not differ by hostname.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	reverse_proxy web:3000
}

# --- LiveKit CONTROL plane (Phase-1 calling) — WSS signaling only. The media plane (WebRTC UDP 7882 +
# 7881/TCP + 3478/UDP TURN) does NOT pass through Caddy; it hits the EC2 host directly (see
# infra/livekit/livekit.yaml + the security-group rules). LiveKit is on the chatnet bridge, so Caddy
# reaches its control port by SERVICE NAME (livekit:7880). This block is only live while the `calls`
# compose profile is running; otherwise this one host 502s (every other site is unaffected).
livekit.growblic.com {
	reverse_proxy livekit:7880
}

# --- TURN/TLS cert provisioning (Phase-3 calling) — this block does NOT proxy media; it exists ONLY so
# Caddy obtains + auto-renews the Let's Encrypt cert for turn.growblic.com into caddy_data. LiveKit then
# reads that cert file to serve TURNS (TURN over TLS) on 5349 for restrictive networks (see
# infra/livekit/livekit.yaml turn.tls_port). Requires DNS turn.growblic.com → the EC2 IP and 80/443 reaching
# Caddy (already true). The media plane itself never passes through Caddy.
turn.growblic.com {
	respond "turn" 200
}

# Growblic marketing site (Next.js standalone). Separate compose project: growblic-site.
# www is canonical (site metadataBase/sitemap/robots point at www); apex redirects.
growblic.com {
	redir https://www.growblic.com{uri} permanent
}

www.growblic.com {
	reverse_proxy growblic-site:3000
}
