# PHASE 2 — domains with automatic HTTPS (Let's Encrypt). Requires DNS A-records for each host below
# pointing at the EC2 public IP, and inbound 80+443 open in the security group (80 is needed for the
# ACME challenge). Caddy obtains + renews certs automatically (persisted in the caddy_data volume).
#
# Caddy runs as the `caddy` service in docker-compose.prod.yml. To activate this file, change that
# service's mount from ./infra/caddy/Caddyfile.http to ./infra/caddy/Caddyfile, set in .env:
#   PHX_HOST=api.growblic.com
#   WEB_ORIGIN=https://web.growblic.com,https://admin.growblic.com
#   CORS_ORIGIN=https://web.growblic.com,https://admin.growblic.com
#   MINIO_PUBLIC_ENDPOINT=https://media.growblic.com
# then `docker compose -f docker-compose.prod.yml up -d`.

# --- API + realtime websocket ---
api.growblic.com {
	reverse_proxy gateway:4000
}

# --- Media (MinIO S3 API) — presigned PUT/GET; Host is preserved so SigV4 matches ---
media.growblic.com {
	reverse_proxy minio:9000
}

# --- Web frontend (Next.js `web` service) — one app serves both: chat at /, admin at /admin ---
web.growblic.com {
	reverse_proxy web:3000
}

admin.growblic.com {
	reverse_proxy web:3000
}

# --- LiveKit CONTROL plane (Phase-1 calling) — WSS signaling only. The media plane (WebRTC UDP 7882 +
# 7881/TCP + 3478/UDP TURN) does NOT pass through Caddy; it hits the EC2 host directly (see
# infra/livekit/livekit.yaml + the security-group rules). LiveKit is on the chatnet bridge, so Caddy
# reaches its control port by SERVICE NAME (livekit:7880). This block is only live while the `calls`
# compose profile is running; otherwise this one host 502s (every other site is unaffected).
livekit.growblic.com {
	reverse_proxy livekit:7880
}
