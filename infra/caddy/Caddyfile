# PHASE 2 — domains with automatic HTTPS (Let's Encrypt). Requires DNS A-records for each host below
# pointing at the EC2 public IP, and inbound 80+443 open in the security group (80 is needed for the
# ACME challenge). Caddy obtains + renews certs automatically (persisted in the caddy_data volume).
#
# Caddy runs as the `caddy` service in docker-compose.prod.yml. To activate this file, change that
# service's mount from ./infra/caddy/Caddyfile.http to ./infra/caddy/Caddyfile, set in .env:
#   PHX_HOST=api.growblic.com
#   WEB_ORIGIN=https://web.growblic.com,https://admin.growblic.com
#   CORS_ORIGIN=https://web.growblic.com,https://admin.growblic.com
#   MINIO_PUBLIC_ENDPOINT=https://media.growblic.com
# then `docker compose -f docker-compose.prod.yml up -d`.

# =====================================================================================================
# SHARED SNIPPETS — imported into every site block below. Defined once so the posture cannot differ by
# hostname, which is the same reason the security headers are duplicated rather than left off one host.
# =====================================================================================================

# SCANNER / BOT PROBES. Commodity scanners sweep every public IP for WordPress, exposed .env files,
# phpMyAdmin and friends. None of these paths exist here, so today they reach the gateway, cost a
# round-trip through Elixir, and fill the log with noise that hides real 404s.
#
# `abort` CLOSES THE CONNECTION without a response — nginx's 444. A scanner learns nothing at all:
# not the server, not a status code, not even that something answered. A 403 would confirm there is
# something here worth probing.
#
# CAREFULLY NOT MATCHED: `/.well-known/*`. Android app-link verification is served from
# `/.well-known/assetlinks.json` on web.growblic.com, and Let's Encrypt fetches
# `/.well-known/acme-challenge/*` on EVERY host to renew certificates. A `/.*` catch-all here would
# break both — silently for app links, and eventually fatally for TLS. The `.` patterns below are
# therefore specific files, never a wildcard on the leading dot.
(scanner_block) {
	@probe {
		path /wp-admin* /wp-login.php* /wp-content* /wp-includes* /wordpress* /xmlrpc.php
		path /.env /.env.* /.git/* /.svn/* /.DS_Store
		path /phpmyadmin* /pma* /PMA* /mysqladmin*
		path /cgi-bin/* /vendor/phpunit/* /shell* /solr/* /console/*
		path /administrator/* /admin.php /config.php /info.php /phpinfo.php
	}
	abort @probe
}

# ACCESS LOGS. Nothing recorded what was hitting this box at all, so "is that traffic real?" had no
# answer. JSON, because the only tooling on a single EC2 box is jq.
#
# ROTATION: 10 MiB per file, 5 kept, 14 days maximum. Bounded on both axes on purpose — this is a
# small instance and an unrotated access log under a scanner sweep is a full disk, which takes
# Postgres down with it.
#
# WHAT IS REDACTED, AND WHY EACH ONE. The query string is not incidental data here:
#
#   * `phone`       — GET /api/v1/users/by-phone?phone=+15550199001 puts a REAL PHONE NUMBER in the
#                     URI. Logging it would write personal data to disk on every contact lookup.
#   * `poll_token`  — GET /api/v1/link/qr/:id/wait?poll_token=… is a CAPABILITY: it is what the QR
#                     device-linking browser exchanges for a session. In a log it is a stolen session.
#   * X-Amz-*       — presigned media URLs carry SigV4 credentials and signatures in the query.
#                     Anyone reading the log could fetch the object until the URL expires.
#   * Authorization,
#     Cookie        — bearer tokens and session cookies. Deleted outright rather than replaced.
#
# `replace` rather than `delete` for the query params, so the log still shows THAT a lookup happened
# and with which shape — which is the whole point of having the log — without the value.
(access_log) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 336h
		}
		format filter {
			wrap json
			fields {
				request>uri query {
					replace phone REDACTED
					replace phone_number REDACTED
					replace poll_token REDACTED
					replace token REDACTED
					replace X-Amz-Signature REDACTED
					replace X-Amz-Credential REDACTED
					replace X-Amz-Security-Token REDACTED
				}
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>Set-Cookie delete
			}
		}
	}
}

# --- API + realtime websocket ---
api.growblic.com {
	import scanner_block
	import access_log

	header {
		# HSTS: the API is HTTPS-only in production and every client already speaks it.
		Strict-Transport-Security "max-age=31536000"
		# JSON is JSON. Stops a browser sniffing an error body into something executable.
		X-Content-Type-Options "nosniff"
	}

	reverse_proxy gateway:4000
}

# --- Media (MinIO S3 API) — presigned PUT/GET; Host is preserved so SigV4 matches ---
#
# THE UPLOADED CONTENT-TYPE IS ATTACKER-CHOSEN. The presign signs `SignedHeaders=host` ONLY
# (MediaService.Storage), so MinIO never validates the Content-Type a client sends on the PUT — the
# server-side allowlist in MediaService.Media governs the DATABASE ROW, not the stored object. A user
# can declare image/png at create, PUT bytes as text/html, and MinIO will serve them back as text/html.
#
# These three headers make that inert without touching the signing path:
#   * Content-Disposition attachment — a top-level navigation DOWNLOADS instead of rendering, so
#     stored HTML/SVG cannot execute on this origin. <img>/<video> subresource loading is UNAFFECTED
#     (the header only governs how a navigation is handled), so chat media renders exactly as before.
#   * nosniff — stops a browser inferring a richer type than the one served.
#   * CSP sandbox — a fully-restricted origin for anything that does get rendered: no scripts, no
#     forms, no same-origin privileges.
#
# Header manipulation does not disturb SigV4: the signature covers the request's host and query, and
# these are RESPONSE headers.
media.growblic.com {
	import scanner_block
	import access_log

	header {
		Content-Disposition "attachment"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "sandbox"
	}

	# CACHEABLE MEDIA — dating deck photos, and ONLY those.
	#
	# MinIO sends no Cache-Control, so every fetch re-downloads even when the URL is unchanged. The
	# media service now mints dating photo URLs with a 2h window (X-Amz-Expires=7200) and a signature
	# rounded to a 1h bucket, so the SAME URL comes back for an hour — which is what makes a browser
	# cache able to hit at all. This header is the other half.
	#
	# MATCHED ON THE SIGNED WINDOW, deliberately, rather than applied to the whole host: 7200 is the
	# cacheable profile's window and nothing else uses it (chat media 900s, status 300s, view-once
	# 120s). A blanket Cache-Control here would make VIEW-ONCE bytes re-readable from the browser
	# cache after the server-side deny — the one thing this host must never do.
	#
	# max-age = the BUCKET (3600), not the window: an hour is the longest a cached entry can still be
	# the current URL, and it is also the minimum validity a freshly-issued URL has left. `immutable`
	# because the bytes behind an object key never change — no revalidation inside the hour.
	@cacheable_media query X-Amz-Expires=7200
	header @cacheable_media Cache-Control "private, max-age=3600, immutable"

	reverse_proxy minio:9000
}

# --- Web frontend (Next.js `web` service) — one app serves both: chat at /, admin at /admin ---
#
# ANDROID APP-LINK VERIFICATION (/.well-known/assetlinks.json). Read this before changing it — this
# exact block has taken production down TWICE:
#   1. A SECOND `web.growblic.com { }` block → "ambiguous site definition" → Caddy restart-looped.
#      api/web/media ALL proxy through this Caddy, so the whole site went down. There must be exactly
#      ONE block per site name; the handler below lives INSIDE the existing one.
#   2. `web.growblic.com.` (trailing dot) as an additional site name → "subject does not qualify for
#      certificate" → same outcome.
# And it is a `file_server`, NOT `respond`, for a third reason: `respond` with a backtick-quoted JSON
# body returned HTTP 200 with content-length: 0 — the body never survived Caddyfile quoting, so the
# endpoint looked healthy and served nothing. DO NOT "simplify" this back into a respond.
#
# THE FINGERPRINT IN assetlinks.json BELONGS TO THE RELEASE KEYSTORE. If the app is ever re-signed
# (new keystore, Play App Signing enrolment, or a key rotation), that SHA-256 changes and this file
# MUST be updated in the same change — otherwise Android silently stops verifying and every deep link
# reverts to the chooser dialog, with no server-side error to notice.
web.growblic.com {
	import scanner_block
	import access_log

	# Site-level response headers. Deliberately INSIDE the existing block — a second `web.growblic.com`
	# block is an "ambiguous site definition" that restart-loops Caddy and takes api/web/media down with
	# it (see the warning below; it has happened twice).
	#
	# NO full Content-Security-Policy here this pass: Next.js inlines bootstrap scripts and a CSP written
	# without measuring which hashes/nonces it needs would break the app on deploy. That is its own slice.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# First matching `handle` wins; the second is the catch-all. Explicit handles (rather than a bare
	# reverse_proxy alongside a matcher) keep the precedence obvious to the next reader.
	handle /.well-known/assetlinks.json {
		root * /srv
		header Content-Type application/json
		file_server
	}

	# iOS UNIVERSAL LINKS (/.well-known/apple-app-site-association). INLINE, not a mounted file: a new
	# bind mount would require RECREATING the caddy container, and the rule here is validate + reload
	# only. `respond` needs no mount, so a change to this JSON ships with a reload like everything else.
	#
	# THE QUOTING IS THE WHOLE RISK. A previous `respond` with a BACKTICK-quoted JSON body served
	# HTTP 200 with content-length: 0 — the body did not survive Caddyfile parsing, and because the
	# status was 200 the endpoint looked perfectly healthy while serving nothing. `caddy validate` does
	# NOT catch that. So: ONE line, double quotes, inner quotes escaped as \" — and the deploy check is
	# `curl` reading the BODY, never just the status code.
	#
	# Three more things iOS is strict about:
	#   * no .json extension (Apple fetches this exact path), so Content-Type must be set explicitly —
	#     without the header below it is text/plain and iOS rejects the file;
	#   * HTTPS with NO redirect, which is why it is here and not on the apex `growblic.com` redir block;
	#   * inside THIS site block. A second `web.growblic.com { }` is an ambiguous site definition that
	#     restart-loops Caddy and takes api and media down with it (it has happened twice).
	#
	# THE TEAM ID PREFIX IS PART OF THE IDENTITY. `FXGBWKT8FB.com.growblic.exway` must match the app's
	# Associated Domains entitlement (`applinks:web.growblic.com`) exactly; a wrong prefix fails
	# silently and every link falls back to Safari with no server-side error to notice.
	handle /.well-known/apple-app-site-association {
		header Content-Type application/json
		respond "{\"applinks\":{\"details\":[{\"appIDs\":[\"FXGBWKT8FB.com.growblic.exway\"],\"components\":[{\"/\":\"/call/*\"},{\"/\":\"/join/*\"}]}]}}" 200
	}

	handle {
		reverse_proxy web:3000
	}
}

admin.growblic.com {
	import scanner_block
	import access_log

	# Same three as the web host — one app serves both, so the posture must not differ by hostname.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	reverse_proxy web:3000
}

# --- LiveKit CONTROL plane (Phase-1 calling) — WSS signaling only. The media plane (WebRTC UDP 7882 +
# 7881/TCP + 3478/UDP TURN) does NOT pass through Caddy; it hits the EC2 host directly (see
# infra/livekit/livekit.yaml + the security-group rules). LiveKit is on the chatnet bridge, so Caddy
# reaches its control port by SERVICE NAME (livekit:7880). This block is only live while the `calls`
# compose profile is running; otherwise this one host 502s (every other site is unaffected).
livekit.growblic.com {
	import scanner_block
	import access_log

	reverse_proxy livekit:7880
}

# --- TURN/TLS cert provisioning (Phase-3 calling) — this block does NOT proxy media; it exists ONLY so
# Caddy obtains + auto-renews the Let's Encrypt cert for turn.growblic.com into caddy_data. LiveKit then
# reads that cert file to serve TURNS (TURN over TLS) on 5349 for restrictive networks (see
# infra/livekit/livekit.yaml turn.tls_port). Requires DNS turn.growblic.com → the EC2 IP and 80/443 reaching
# Caddy (already true). The media plane itself never passes through Caddy.
turn.growblic.com {
	respond "turn" 200
}

# Growblic marketing site (Next.js standalone). Separate compose project: growblic-site.
# www is canonical (site metadataBase/sitemap/robots point at www); apex redirects.
growblic.com {
	redir https://www.growblic.com{uri} permanent
}

www.growblic.com {
	import scanner_block
	import access_log

	reverse_proxy growblic-site:3000
}
